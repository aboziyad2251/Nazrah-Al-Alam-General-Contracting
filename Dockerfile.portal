# ─── Stage 1: base ────────────────────────────────────────────────────────────
FROM node:22-alpine AS base
ENV PNPM_HOME="/pnpm" PATH="/pnpm:$PATH"
RUN corepack enable pnpm && corepack prepare pnpm@9.0.0 --activate

# ─── Stage 2: install workspace deps ──────────────────────────────────────────
FROM base AS deps
WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY turbo.json* ./
COPY apps/portal/package.json          ./apps/portal/
COPY packages/ui/package.json          ./packages/ui/
RUN mkdir -p packages/i18n packages/types && \
    echo '{"name":"@nazrah/i18n","version":"0.0.1"}' > packages/i18n/package.json && \
    echo '{"name":"@nazrah/types","version":"0.0.1"}' > packages/types/package.json

RUN pnpm install --frozen-lockfile

# ─── Stage 3: vite build ──────────────────────────────────────────────────────
FROM base AS builder
WORKDIR /app

COPY --from=deps /app/node_modules ./node_modules
COPY . .

# VITE_* vars are baked into the JS bundle at build time — anon key is public
ARG VITE_SUPABASE_URL
ARG VITE_SUPABASE_ANON_KEY
ARG VITE_APP_VERSION=latest
ENV VITE_SUPABASE_URL=$VITE_SUPABASE_URL \
    VITE_SUPABASE_ANON_KEY=$VITE_SUPABASE_ANON_KEY \
    VITE_APP_VERSION=$VITE_APP_VERSION

RUN pnpm --filter @nazrah/portal build

# ─── Stage 4: nginx serving ────────────────────────────────────────────────────
FROM nginx:1.27-alpine AS runner

# Remove default config
RUN rm /etc/nginx/conf.d/default.conf

# Non-root nginx: change worker process ownership
RUN chown -R nginx:nginx /var/cache/nginx /var/log/nginx \
 && chmod -R 755 /var/cache/nginx \
 && touch /var/run/nginx.pid \
 && chown nginx:nginx /var/run/nginx.pid

COPY nginx/portal.conf /etc/nginx/conf.d/portal.conf

# Copy built assets from builder
COPY --from=builder --chown=nginx:nginx /app/apps/portal/dist /usr/share/nginx/html

USER nginx
EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -qO- http://localhost:8080/health || exit 1

CMD ["nginx", "-g", "daemon off;"]
