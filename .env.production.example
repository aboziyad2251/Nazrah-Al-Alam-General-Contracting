# ── Copy this file to /opt/nazrah/.env on the VPS ────────────────────────────
# cp .env.production.example /opt/nazrah/.env
# nano /opt/nazrah/.env   ← fill in every value

# ── Domain ────────────────────────────────────────────────────────────────────
# Your root domain. Subdomains will be auto-derived:
#   nazrahalalam.com        → public website
#   www.nazrahalalam.com    → public website (redirects to apex)
#   app.nazrahalalam.com    → client portal
#   admin.nazrahalalam.com  → admin panel
#   traefik.nazrahalalam.com → Traefik dashboard (SSH-tunnel only)
DOMAIN=nazrahalalam.com

# ── Let's Encrypt ─────────────────────────────────────────────────────────────
ACME_EMAIL=admin@nazrahalalam.com

# ── GHCR image tags (set by CI; override for manual deploy) ──────────────────
GHCR_REPO=aboziyad2251
WEB_TAG=latest
PORTAL_TAG=latest
ADMIN_TAG=latest

# ── Supabase (get from Supabase dashboard → Project Settings → API) ───────────
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── PostgreSQL (local — used for backups & staging; Supabase is primary DB) ──
POSTGRES_DB=nazrah
POSTGRES_USER=nazrah
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_strong_redis_password_here

# ── Slack (optional — deploy & Watchtower notifications) ──────────────────────
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
