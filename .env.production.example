# ── Copy to /opt/nazrah/.env on the VPS and fill every value ─────────────────

# ── Subdomains (algarni.online, VPS IP: 76.13.40.119) ────────────────────────
WEB_HOST=nazrah-mainx.algarni.online
PORTAL_HOST=nazrah-client.algarni.online
ADMIN_HOST=nazrah-app.algarni.online

# ── Let's Encrypt ─────────────────────────────────────────────────────────────
ACME_EMAIL=admin@algarni.online

# ── GHCR image tags (set by CI automatically) ─────────────────────────────────
GHCR_REPO=aboziyad2251
WEB_TAG=latest
PORTAL_TAG=latest
ADMIN_TAG=latest

# ── Supabase (Supabase dashboard → Project Settings → API) ───────────────────
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...REPLACE_ME

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=nazrah
POSTGRES_USER=nazrah
POSTGRES_PASSWORD=CHANGE_ME_strong_password

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_strong_redis_password

# ── Slack (optional) ──────────────────────────────────────────────────────────
SLACK_WEBHOOK_URL=
