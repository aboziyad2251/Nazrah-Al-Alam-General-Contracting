{
  "expo": {
    "name": "Nazrah Al Alam",
    "slug": "nazrah-client",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "nazrah",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0E1F3A"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.nazrahalalam.client",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Used to photograph equipment and job sites for AI analysis.",
        "NSPhotoLibraryUsageDescription": "Used to select existing photos for site surveys.",
        "NSFaceIDUsageDescription": "Used to unlock the app with Face ID.",
        "NSLocationWhenInUseUsageDescription": "Used to pre-fill delivery address in quotes."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0E1F3A"
      },
      "package": "com.nazrahalalam.client",
      "versionCode": 1,
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "$(PRODUCT_NAME) uses the camera to photograph equipment and job sites for AI analysis.",
          "microphonePermission": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "$(PRODUCT_NAME) accesses your photos to attach to site surveys.",
          "cameraPermission": "$(PRODUCT_NAME) uses the camera to photograph job sites."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "$(PRODUCT_NAME) uses Face ID to securely unlock the app."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#0E1F3A",
          "sounds": []
        }
      ],
      "expo-secure-store",
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "your-eas-project-id"
      }
    },
    "owner": "your-expo-account"
  }
}
