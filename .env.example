## Nazrah Al Alam — Environment Variables Template
## Production copy lives at /opt/nazrah/.env on the VPS.
## NEVER commit .env or .env.production to the repository.
##
## To encrypt for safe check-in (using age):
##   age --encrypt --recipient <AGE_PUBLIC_KEY> .env > .env.production.age
##   git add .env.production.age && git commit
##
## To decrypt on VPS:
##   age --decrypt --identity ~/.config/age/key.txt .env.production.age > .env

# ── GHCR image registry ───────────────────────────────────────────────────────
# Owner of the GitHub repository (must be lowercased)
GHCR_REPO=yourgithubusername

# Image tags — updated by GitHub Actions; can pin to a specific SHA
WEB_TAG=latest
PORTAL_TAG=latest

# ── Traefik TLS ───────────────────────────────────────────────────────────────
ACME_EMAIL=admin@nazrahalalam.com

# ── Supabase ──────────────────────────────────────────────────────────────────
# These public (anon) keys are baked into the browser bundles at build time
# and are safe to expose. The build step uses them via GitHub Secrets.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service role key — never exposed to browser, used server-side only
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PROJECT_REF=your-project-ref

# ── AI providers ──────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=AIza...

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=re_...

# ── PostgreSQL (self-hosted staging DB) ────────────────────────────────────────
POSTGRES_DB=nazrah
POSTGRES_USER=nazrah
POSTGRES_PASSWORD=change-this-to-a-strong-32-char-password

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=change-this-to-a-strong-redis-password

# ── Notifications ─────────────────────────────────────────────────────────────
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T.../B.../...

# ── Backups ───────────────────────────────────────────────────────────────────
# age public key of backup recipient (generate: age-keygen | tee key.txt)
AGE_RECIPIENT=age1qqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqq
# age private key file path on VPS (for restore decryption)
AGE_IDENTITY=/root/.config/age/key.txt
# rclone remote + bucket (configure with: rclone config)
RCLONE_REMOTE=b2:nazrah-backups
BACKUP_RETENTION_DAYS=30

# ── Monitoring (optional — used by docker-compose.monitoring.yml) ─────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-this-grafana-password
